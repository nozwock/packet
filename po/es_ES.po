#: data/io.github.nozwock.Packet.metainfo.xml.in.in:10
msgid ""
"Send and receive files wirelessly with Android devices using Quick Share or "
"another device with Packet installed."
msgstr ""
"Envíe y reciba archivos de forma inalámbrica con dispositivos Android "
"mediante Quick Share u otro dispositivo con Packet instalado."

