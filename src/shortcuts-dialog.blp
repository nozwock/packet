using Gtk 4.0;
using Adw 1;

Adw.ShortcutsDialog shortcuts_dialog {
    Adw.ShortcutsSection {
        title: C_("shortcut window", "Actions");

        Adw.ShortcutsItem {
            title: C_("shortcut window", "Send To…");
            accelerator: "<Primary>Return";
        }

        Adw.ShortcutsItem {
            title: C_("shortcut window", "Paste");
            accelerator: "<Primary>v";
        }
    }

    Adw.ShortcutsSection {
        title: C_("shortcut window", "General");

        Adw.ShortcutsItem {
            title: C_("shortcut window", "Show Help");
            action-name: "win.help";
        }

        Adw.ShortcutsItem {
            title: C_("shortcut window", "Open Menu");
            accelerator: "F10";
        }

        Adw.ShortcutsItem {
            title: C_("shortcut window", "Open Preferences");
            action-name: "win.preferences";
        }

        Adw.ShortcutsItem {
            title: C_("shortcut window", "Shortcuts");
            action-name: "app.shortcuts";
        }

        Adw.ShortcutsItem {
            title: C_("shortcut window", "Close or Hide Window");
            action-name: "window.close";
        }

        Adw.ShortcutsItem {
            title: C_("shortcut window", "Quit");
            action-name: "app.quit";
        }
    }
}
